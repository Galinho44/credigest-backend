# Credigest - Variáveis de ambiente
# Copie para .env e preencha: cp .env.example .env

# =====================================================================
# Servidor
# =====================================================================
NODE_ENV=desenvolvimento
PORT=3000
HOST=127.0.0.1

# Caminho do banco SQLite (criado automaticamente)
CREDIGEST_DB=dados/credigest.db

# =====================================================================
# Gateway de pagamento
# =====================================================================
# Use "simulado" para testar sem conta Asaas
# Use "asaas" para produção (exige ASAAS_ACCESS_TOKEN)
GATEWAY=simulado

# Timeout para chamadas ao gateway (ms)
GATEWAY_TIMEOUT_MS=8000

# --- Asaas (só necessário se GATEWAY=asaas) ---
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_ACCESS_TOKEN=
ASAAS_AMBIENTE=sandbox

# Token do webhook (OBRIGATÓRIO em ambos os gateways)
# Gere: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=

# Dados do recebedor no Pix
PIX_RECEBEDOR=credigest
PIX_CIDADE=Salvador

# =====================================================================
# Autenticação (OBRIGATÓRIO em produção)
# =====================================================================
# Usuario/senha para acessar o painel e API
# Em produção, SEMPRE defina ambos
AUTH_USUARIO=
AUTH_SENHA=

# Nome do cookie de sessão (padrão: credigest_sessao)
AUTH_SESSAO_NOME=credigest_sessao

# Tempo de vida do cookie em segundos (padrão: 30 dias)
AUTH_SESSAO_MAX_AGE=2592000

# =====================================================================
# Supabase (não usado atualmente - para migração futura)
# =====================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=