# ---- Credigest: variaveis de ambiente ----
# Copie este arquivo para ".env" e preencha.
# NUNCA versione o arquivo ".env" no git (ele esta no .gitignore).

# Servidor HTTP
PORT=3000
HOST=0.0.0.0

# Banco de dados
# Desenvolvimento local: SQLite (arquivo ou :memory: para testes)
CREDIGEST_DB=dados/credigest.db
# Producao (Railway): Supabase/PostgreSQL
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_KEY=eyJ...

# ---- Gateway de pagamento ----
# "simulado" = nao chama ninguem, gera Pix falso. Use para testar offline.
# "asaas"    = chama a API real do Asaas (precisa de ASAAS_ACCESS_TOKEN).
GATEWAY=simulado

# Ambiente do Asaas: "sandbox" (dinheiro ficticio) ou "producao" (dinheiro real)
ASAAS_AMBIENTE=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token da API do Asaas. Fica SÓ na sua máquina.
ASAAS_ACCESS_TOKEN=
# Token que o Asaas manda no header "asaas-access-token" de cada webhook.
# Regras do Asaas: entre 32 e 255 caracteres, sem espaços, sem sequência simples.
# OBRIGATÓRIO nos dois modos: sem ele, qualquer um que descubra a URL do
# webhook manda "pago" numa cobrança que não foi paga.
# Gere um:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=troque-este-valor-por-um-aleatorio-de-48-characters-ok

# Identificador enviado em todo Pix gerado (aparece na fila do banco do cliente)
PIX_RECEBEDOR=credigest-exemplo
PIX_CIDADE=Salvador

# Tempo maximo de espera por resposta do gateway (ms)
GATEWAY_TIMEOUT_MS=8000

# Variavel para o Railway saber que esta em producao
# NODE_ENV=production