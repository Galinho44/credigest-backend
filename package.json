{
  "name": "credigest",
  "version": "1.0.0",
  "description": "Credigest - gestao de cobrancas com Pix e baixa automatica via webhook",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/banco/migrar.js",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "inspect": "node --env-file-if-exists=.env teste/inspecionar-banco.js",
    "test": "node --test --test-timeout=30000"
  },
  "dependencies": {},
  "devDependencies": {},
  "private": true
}